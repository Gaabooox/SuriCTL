#!/bin/bash

# ==========================================
# surictl - Control simple para Suricata
# ==========================================

# ========= COLORES =========
RED="\e[31m"
GREEN="\e[32m"
YELLOW="\e[33m"
BLUE="\e[34m"
CYAN="\e[36m"
MAGENTA="\e[35m"
WHITE="\e[37m"
BOLD="\e[1m"
DIM="\e[2m"
RESET="\e[0m"

# ========= RUTAS =========
SURICATA_CONF="/etc/suricata/suricata.yaml"
LOCAL_RULES="/var/lib/suricata/rules/local.rules"
EVE_LOG="/var/log/suricata/eve.json"
FAST_LOG="/var/log/suricata/fast.log"
STATS_LOG="/var/log/suricata/stats.log"
# ========= FUNCIONES VISUALES =========

line() {
    printf "%b\n" "${CYAN}============================================================${RESET}"
}

small_line() {
    printf "%b\n" "${DIM}------------------------------------------------------------${RESET}"
}

logo() {
    printf "%b" "${CYAN}${BOLD}"
    cat << "EOF"
   _____            _   _____ _______ _
  / ____|          (_) / ____|__   __| |
 | (___  _   _ _ __ _ | |       | |  | |
  \___ \| | | | '__| || |       | |  | |
  ____) | |_| | |  | |\ |____   | |  | |____
 |_____/ \__,_|_|  |_| \_____|  |_|  |______|
EOF
    printf "%b\n" "${RESET}"
}

title() {
    line
    printf "%b\n" "${BOLD}${WHITE}                    SURICATA CONTROL${RESET}"
    line
}

subtitle() {
    printf "\n%b\n" "${BOLD}${BLUE}$1${RESET}"
    small_line
}

ok() {
    printf "%b\n" "${GREEN}[OK]${RESET} $1"
}

info() {
    printf "%b\n" "${CYAN}[INFO]${RESET} $1"
}

warn() {
    printf "%b\n" "${YELLOW}[AVISO]${RESET} $1"
}

error() {
    printf "%b\n" "${RED}[ERROR]${RESET} $1"
}

pause() {
    printf "\n%b" "${DIM}Presiona Enter para continuar...${RESET}"
    read -r
}

option() {
    printf "%b\n" "${GREEN}$1)${RESET} $2"
}

danger_option() {
    printf "%b\n" "${RED}$1)${RESET} $2"
}

# ======================================================
# STATUS SURICATA
# ======================================================

activar_suricata() {

    clear
    logo
    title
    subtitle "Activando Suricata"

    if sudo systemctl start suricata; then
        ok "Suricata activado."
    else
        error "No se pudo activar Suricata."
    fi

    pause
}

desactivar_suricata() {

    clear
    logo
    title
    subtitle "Desactivando Suricata"

    if sudo systemctl stop suricata; then
        ok "Suricata desactivado."
    else
        error "No se pudo desactivar Suricata."
    fi

    pause
}

ver_estado() {

    clear
    logo
    title
    subtitle "Estado de Suricata"

    estado=$(systemctl is-active suricata 2>/dev/null)
    inicio=$(systemctl is-enabled suricata 2>/dev/null)

    printf "%b\n" "${BOLD}Servicio:${RESET} suricata"

    case "$estado" in

        active)
            printf "%b\n" "${BOLD}Estado:${RESET} ${GREEN}active (running)${RESET}"
            ;;

        inactive)
            printf "%b\n" "${BOLD}Estado:${RESET} ${YELLOW}inactive (dead)${RESET}"
            ;;

        *)
            printf "%b\n" "${BOLD}Estado:${RESET} ${RED}$estado${RESET}"
            ;;

    esac

    case "$inicio" in

        enabled)
            printf "%b\n" "${BOLD}Inicio automático:${RESET} ${GREEN}enabled${RESET}"
            ;;

        disabled)
            printf "%b\n" "${BOLD}Inicio automático:${RESET} ${YELLOW}disabled${RESET}"
            ;;

        *)
            printf "%b\n" "${BOLD}Inicio automático:${RESET} ${RED}$inicio${RESET}"
            ;;

    esac

    printf "\n"

    small_line
    info "Vista resumida del servicio"
    small_line

    systemctl status suricata --no-pager | awk '

        /suricata.service;/ {

            gsub(";", "", $4)
            print "Loaded :", $4

        }

        /Active:/ {

            gsub(",", "", $3)
            print "Active :", $2, $3

        }

    '

    pause
}

reiniciar_suricata() {

    clear
    logo
    title
    subtitle "Reiniciar Suricata"

    info "Reiniciando servicio..."

    if sudo systemctl restart suricata; then
        ok "Suricata reiniciado correctamente."
    else
        error "No se pudo reiniciar Suricata."
    fi

    pause
}

test_suricata() {

    clear
    logo
    title
    subtitle "Validar configuración"

    info "Comprobando configuración y reglas..."

    if sudo suricata -T -c "$SURICATA_CONF" -v |
        awk '/Notice: suricata: Configuration provided was successfully loaded. Exiting./ { print $3 " " $5 " " $6 " " $7 }'
    then

        ok "Configuración aprobada."

    else

        error "La configuración contiene errores."

    fi

    pause
}

status_suricata() {

    while true; do

        clear
        logo
        title

        printf "\n%b\n" "${BOLD}${WHITE}                 STATUS SURICATA${RESET}"
        small_line

        option "1" "Ver estado actual"
        option "2" "Activar Suricata"
        option "3" "Desactivar Suricata"
        option "4" "Reiniciar Suricata"
        option "5" "Validar configuración"

        danger_option "0" "Volver al menú principal"

        small_line
        printf "\n"

        read -rp "Selecciona una opción: " option

        case "$option" in

            1)
                ver_estado
                ;;

            2)
                activar_suricata
                ;;

            3)
                desactivar_suricata
                ;;

            4)
                reiniciar_suricata
                ;;

            5)
                test_suricata
                ;;

            0)
                break
                ;;

            *)
                error "Opción inválida."
                sleep 1
                ;;

        esac

    done
}

# REGLAS SURICATA

ver_todas_reglas() {
    clear
    logo
    title
    subtitle "Todas las reglas locales"

    if sudo test -s /var/lib/suricata/rules/local.rules; then
        sudo cat /var/lib/suricata/rules/local.rules | nl -w2 -s') '
    else
        warn "No hay reglas locales o el archivo está vacío."
    fi
    pause
}

ver_reglas_activas() {
    clear
    logo
    title
    subtitle "Reglas activas"

    if sudo grep -qvE '^\s*#|^\s*$' "$LOCAL_RULES"; then
        printf "%b" "${GREEN}"
        sudo grep -vE '^\s*#|^\s*$' "$LOCAL_RULES" | nl -w2 -s') '
        printf "%b" "${RESET}"
    else
        warn "No hay reglas activas."
    fi

    pause
}

ver_reglas_inactivas() {
    clear
    logo
    title
    subtitle "Reglas inactivas"

    if sudo grep -qE '^\s*#' "$LOCAL_RULES"; then
        printf "%b" "${RED}"
        sudo grep -E '^\s*#' "$LOCAL_RULES" | nl -w2 -s') '
        printf "%b" "${RESET}"
    else
        warn "No hay reglas inactivas."
    fi

    pause
}

validar_reglas() {

    info "Validando reglas Suricata..."

    if sudo suricata -T -c "$SURICATA_CONF" >/tmp/suricata_test.log 2>&1; then
        ok "Reglas válidas."
        return 0
    else
        error "Regla inválida."

        printf "\n"
        echo "Detalle del error:"
        printf "\n"

        sudo cat /tmp/suricata_test.log

        return 1
    fi
}

agregar_regla() {
    clear
    logo
    title
    subtitle "Agregar regla local"

    next_sid=$(siguiente_sid)

    info "Escribe la regla que deseas agregar."
    warn "SID sugerido: sid:${next_sid};"
    printf "\n"

    read -rp "Nueva regla: " new_regla

    if [[ -z "$new_regla" ]]; then
        error "No escribiste ninguna regla."
        pause
        return
    fi

    TEMP_RULE="/tmp/local.rules.test"

    printf "\n"
    info "Creando archivo temporal de prueba..."

    sudo cp "$LOCAL_RULES" "$TEMP_RULE"

    if [[ $? -ne 0 ]]; then
        error "No se pudo crear la copia temporal."
        pause
        return
    fi


    info "Probando nueva regla con Suricata..."

    echo "$new_regla" | sudo tee -a "$TEMP_RULE" >/dev/null


    if sudo suricata -T \
        -c "$SURICATA_CONF" \
        -S "$TEMP_RULE" \
        >/tmp/suricata_test.log 2>&1
    then

        ok "La regla es válida."

        printf "\n"
        info "Guardando regla en local.rules..."

        if sudo cp "$TEMP_RULE" "$LOCAL_RULES"; then
            ok "Regla agregada correctamente."
        else
            error "No se pudo guardar la regla."
            pause
            return
        fi


        printf "\n"
        info "Reiniciando Suricata..."

        if sudo systemctl restart suricata; then
            ok "Suricata reiniciado correctamente."
        else
            error "La regla fue guardada pero Suricata no pudo reiniciarse."
        fi


    else

        error "La regla tiene errores y no fue agregada."

        printf "\n"
        small_line
        printf "%b\n" "${RED}Error detectado:${RESET}"
        small_line

        sudo cat /tmp/suricata_test.log

        small_line

    fi


    sudo rm -f /tmp/suricata_test.log
    sudo rm -f "$TEMP_RULE"

    pause
}

eliminar_regla() {
    clear
    logo
    title
    subtitle "Eliminar regla"

    info "Escribe el SID de la regla que deseas eliminar."
    printf "\n"

    read -rp "SID: " sid

    if [[ -z "$sid" ]]; then
        error "No escribiste el SID de la regla."
        pause
        return
    fi

    info "Eliminando regla..."
    printf "\n"

    sudo sed -i "/sid:$sid/d" "$LOCAL_RULES"

    if [[ $? -eq 0 ]]; then
        ok "Regla eliminada."
    else
        error "No se pudo eliminar la regla."
    fi

    printf "\n"
    info "Reiniciando Suricata para aplicar cambios..."
    if sudo systemctl restart suricata; then
        ok "Suricata reiniciado correctamente."
    else
        error "La regla se eliminó, pero Suricata no pudo reiniciarse."
    fi

    pause
}

editar_rules_manual() {
    clear
    logo
    title
    subtitle "Editar reglas manualmente"

    info "Abriendo archivo local.rules con nano..."
    printf "\n"

    sudo nano "$LOCAL_RULES"

    clear
    logo
    title
    subtitle "Comprobando configuración"

    info "Probando configuración después de editar reglas..."
    printf "\n"

    if sudo suricata -T -c "$SURICATA_CONF" -v | awk '/Notice: suricata: Configuration provided was successfully loaded. Exiting./ { print $3 " " $5 " " $6 " " $7 }'; then
        printf "\n"
        ok "Configuración aprobada."
    else
        printf "\n"
        error "Hay un problema en la configuración o en alguna regla."
    fi

    pause
}

test_aplicar() {
    clear
    logo
    title
    subtitle "Testear y aplicar reglas"

    info "Probando configuración después de editar reglas..."
    printf "\n"

    if sudo suricata -T -c "$SURICATA_CONF" -v | awk '/Notice: suricata: Configuration provided was successfully loaded. Exiting./ { print $3 " " $5 " " $6 " " $7 }'; then
        printf "\n"
        ok "Configuración aprobada."
        info "Reiniciando Suricata para aplicar cambios..."
        if sudo systemctl restart suricata; then
            ok "Suricata reiniciado correctamente."
        else
            error "La regla se agregó, pero Suricata no pudo reiniciarse."
        fi
    else
        printf "\n"
        error "Hay un problema en la configuración o en alguna regla."
    fi

    pause
}

menu_reglas() {
    while true; do
        clear
        logo
        title

        printf "\n%b\n" "${BOLD}${MAGENTA}                    MENU DE REGLAS${RESET}"
        small_line
        option "1" "Ver todas las reglas"
        option "2" "Ver reglas activas"
        option "3" "Ver reglas inactivas"
        option "4" "Agregar regla"
        option "5" "Eliminar regla"
        option "6" "Configurar manualmente"
        option "7" "Testear y aplicar reglas"

        danger_option "0" "Volver al menú principal"
        small_line
        printf "\n"

        read -rp "Selecciona una opción: " opcion1

        case "$opcion1" in
            1)
                ver_todas_reglas
                ;;
            2)
                ver_reglas_activas
                ;;
            3)
                ver_reglas_inactivas
                ;;
            4)
                agregar_regla
                ;;
            5)
                eliminar_regla
                ;;
            6)
                editar_rules_manual
                ;;
            7)
                test_aplicar
                ;;
            0)
                break
                ;;
            *)
                error "Opción inválida."
                sleep 1
                ;;
        esac
    done
}

siguiente_sid() {
    ultimo_sid=$(sudo grep -Eo 'sid:[0-9]+' "$LOCAL_RULES" 2>/dev/null | cut -d':' -f2 | sort -n | tail -n 1)

    if [[ -z "$ultimo_sid" ]]; then
        echo "1000001"
    else
        echo $((ultimo_sid + 1))
    fi
}

#----------------—------------ LOGS ------------------------------------------------------
# Muestra el LOG de Suricata.
#
ver_alertas() {

    clear
    logo
    title

    subtitle "Últimas alertas detectadas"

    if [[ ! -r "$EVE_LOG" ]]; then
        error "No se puede leer eve.json."
        pause
        return
    fi


    info "Mostrando últimas 20 alertas..."
    printf "\n"

    sudo grep '"event_type":"alert"' "$EVE_LOG" | tail -20 | less


    pause
}

ver_eventos_live() {

    clear
    logo
    title

    subtitle "Eventos en tiempo real"

    info "Monitoreando eve.json"
    warn "CTRL+C para salir"

    printf "\n"

    sudo tail -f "$EVE_LOG"

}

buscar_ip() {

    clear
    logo
    title

    subtitle "Buscar IP en eventos"

    read -rp "IP a buscar: " ip


    if [[ -z "$ip" ]]; then
        error "No ingresaste ninguna IP."
        pause
        return
    fi


    printf "\n"

    info "Buscando $ip..."

    printf "\n"


    sudo grep "$ip" "$EVE_LOG" | tail -50 | less


    pause
}

ver_stats() {

    clear
    logo
    title

    subtitle "Estadísticas Suricata"


    if [[ ! -f "$STATS_LOG" ]]; then
        error "No existe stats.log."
        pause
        return
    fi


    sudo tail -50 "$STATS_LOG" | less


    pause
}

abrir_logs() {

    while true; do

        clear
        logo
        title

        subtitle "Abrir logs Suricata"

        option "1" "Abrir eve.json completo"
        option "2" "Abrir eve.json formateado"
        option "3" "Abrir fast.log"
        option "4" "Abrir stats.log"

        danger_option "0" "Volver"

        printf "\n"

        read -rp "Selecciona una opción: " abrir_option


        case "$abrir_option" in

            1)
                sudo less "$EVE_LOG"
                ;;

            2)
                if command -v jq >/dev/null; then
                    sudo jq . "$EVE_LOG" | less
                else
                    error "jq no está instalado."
                    info "Instala jq con: sudo dnf install jq"
                    pause
                fi
                ;;

            3)
                sudo less "$FAST_LOG"
                ;;

            4)
                sudo less "$STATS_LOG"
                ;;

            0)
                break
                ;;

            *)
                error "Opción inválida."
                sleep 1
                ;;

        esac

    done
}

logs_menu() {

    while true; do

        clear
        logo
        title

        printf "\n%b\n" "${BOLD}${MAGENTA}                    MENU DE LOGS${RESET}"
        small_line

        option "1" "Ver últimas alertas (eve.json)"
        option "2" "Ver eventos en vivo"
        option "3" "Buscar IP en eventos"
        option "4" "Ver estadísticas (stats.log)"
        option "5" "Abrir logs"

        danger_option "0" "Volver al menú principal"

        small_line
        printf "\n"

        read -rp "Selecciona una opción: " log_option

        case "$log_option" in

            1)
                ver_alertas
                ;;

            2)
                ver_eventos_live
                ;;

            3)
                buscar_ip
                ;;

            4)
                ver_stats
                ;;

            5)
                abrir_logs
                ;;

            0)
                break
                ;;

            *)
                error "Opción inválida."
                sleep 1
                ;;

        esac

    done
}


#-----------------------------------ALERTAS---------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------------------------------------------------------------------------------------------------------------------------

ver_ultimas_alertas() {

    clear
    logo
    title

    subtitle "Últimas alertas detectadas"


    if [[ ! -r "$EVE_LOG" ]]; then

        error "No se puede leer eve.json."
        pause
        return

    fi


    sudo grep '"event_type":"alert"' "$EVE_LOG" | tail -20 | jq '
    {
        fecha:.timestamp,
        firma:.alert.signature,
        sid:.alert.signature_id,
        severidad:.alert.severity,
        origen:.src_ip,
        destino:.dest_ip,
        protocolo:.proto
    }'


    pause
}

buscar_alerta() {

    clear
    logo
    title

    subtitle "Buscar alerta"


    read -rp "Texto a buscar: " busqueda


    if [[ -z "$busqueda" ]]; then
        error "Campo vacío."
        pause
        return
    fi


    sudo grep -i \
    '"event_type":"alert"' "$EVE_LOG" | grep -i "$busqueda" | jq


    pause
}

filtrar_severidad() {

    clear
    logo
    title

    subtitle "Filtrar severidad"


    echo "1) Alta"
    echo "2) Media"
    echo "3) Baja"


    read -rp "Severidad: " sev


    sudo grep '"event_type":"alert"' "$EVE_LOG" | jq "
    select(.alert.severity==$sev)
    "


    pause
}

filtrar_ip_alerta() {

    clear
    logo
    title

    subtitle "Buscar IP"


    read -rp "IP: " ip


    sudo grep "$ip" "$EVE_LOG" | jq


    pause
}

detalle_alerta() {

    clear
    logo
    title

    subtitle "Detalle alerta"


    read -rp "SID de alerta: " sid


    sudo grep "$sid" "$EVE_LOG" | jq


    pause
}

estadisticas_alertas() {

    clear
    logo
    title

    subtitle "Estadísticas"


    total=$(sudo grep -c '"event_type":"alert"' "$EVE_LOG")


    echo "Total alertas:"
    echo "$total"


    echo ""

    echo "Top firmas:"


    sudo grep '"event_type":"alert"' "$EVE_LOG" |
    jq -r '.alert.signature' |
    sort |
    uniq -c |
    sort -nr |
    head


    pause
}

exportar_alertas() {

    clear
    logo
    title

    subtitle "Exportar alertas"


    archivo="alertas_$(date +%Y%m%d_%H%M).json"


    sudo grep '"event_type":"alert"' "$EVE_LOG" > "$archivo"


    ok "Exportado: $archivo"


    pause
}



menu_alertas() {

    while true; do

        clear
        logo
        title

        printf "\n%b\n" "${BOLD}${MAGENTA}                    MENU DE ALERTAS${RESET}"
        small_line


        option "1" "Ver últimas alertas"
        option "2" "Buscar alerta"
        option "3" "Filtrar por severidad"
        option "4" "Filtrar por IP"
        option "5" "Ver detalle de alerta"
        option "6" "Estadísticas de alertas"
        option "7" "Exportar alertas"


        danger_option "0" "Volver al menú principal"


        small_line
        printf "\n"


        read -rp "Selecciona una opción: " alerta_option


        case "$alerta_option" in

            1)
                ver_ultimas_alertas
                ;;

            2)
                buscar_alerta
                ;;

            3)
                filtrar_severidad
                ;;

            4)
                filtrar_ip_alerta
                ;;

            5)
                detalle_alerta
                ;;

            6)
                estadisticas_alertas
                ;;

            7)
                exportar_alertas
                ;;

            0)
                break
                ;;

            *)
                error "Opción inválida."
                sleep 1
                ;;

        esac

    done
}

#-----------------------------------CONFIGURACION---------------------------------------------------------------------------------------------------------------------------------------
# ------------------------------------------------------------------------------------------------------------------------------------------------------------------

cambiar_interfaz() {

    clear
    logo
    title

    subtitle "Cambiar interfaz de captura"

    info "Interfaces disponibles:"
    printf "\n"

    interfaces=$(ip -o link show | awk -F': ' '{print $2}' | grep -v "lo")

    contador=1
    declare -A lista_interfaces

    while read -r iface; do

        option "$contador" "$iface"
        lista_interfaces[$contador]=$iface
        ((contador++))

    done <<< "$interfaces"


    printf "\n"
    danger_option "0" "Cancelar"

    printf "\n"

    read -rp "Selecciona interfaz: " interfaz_option


    if [[ "$interfaz_option" == "0" ]]; then
        return
    fi


    nueva_interfaz=${lista_interfaces[$interfaz_option]}


    if [[ -z "$nueva_interfaz" ]]; then
        error "Interfaz inválida."
        pause
        return
    fi


    info "Nueva interfaz: $nueva_interfaz"


    sudo sed -i \
    "s/interface: .*/interface: $nueva_interfaz/" \
    "$SURICATA_CONF"


    ok "Interfaz actualizada."

    info "Reiniciando Suricata..."

    sudo systemctl restart suricata


    pause
}

abrir_configuracion() {

    clear
    logo
    title

    subtitle "Editar configuración Suricata"


    warn "Modificar este archivo puede afectar el inicio de Suricata."

    printf "\n"

    read -rp "Presiona Enter para continuar..."

    sudo nano "$SURICATA_CONF"


    pause
}

ver_configuracion_actual() {

    clear
    logo
    title

    subtitle "Configuración actual"


    version=$(suricata --build-info | grep Version | awk '{print $2}')

    interfaz=$(sudo suricata --dump-config | grep "af-packet.0.interface" | awk '{print $3}')

    home=$(sudo suricata --dump-config | grep "HOME_NET" | head -1 | cut -d'=' -f2)


    echo "Versión:"
    echo "$version"

    echo ""

    echo "Interfaz:"
    echo "$interfaz"

    echo ""

    echo "HOME_NET:"
    echo "$home"


    echo ""

    reglas=$(sudo grep -vE '^\s*#|^\s*$' "$LOCAL_RULES" | wc -l)

    echo "Reglas locales:"
    echo "$reglas"


    echo ""

    estado=$(systemctl is-active suricata)

    echo "Estado:"
    echo "$estado"


    pause
}

validar_configuracion() {

    clear
    logo
    title

    subtitle "Validación Suricata"


    info "Comprobando configuración..."


    if sudo suricata -T -c "$SURICATA_CONF" -v; then

        printf "\n"
        ok "Configuración correcta."

    else

        printf "\n"
        error "La configuración tiene errores."

    fi


    pause
}

configurar_home_net() {

    clear
    logo
    title

    subtitle "Configurar HOME_NET"


    actual=$(sudo suricata --dump-config | grep "HOME_NET" | head -1)


    info "Configuración actual:"
    echo "$actual"


    printf "\n"

    read -rp "Nueva red/IP HOME_NET: " nueva_home


    if [[ -z "$nueva_home" ]]; then

        error "Valor vacío."
        pause
        return

    fi


    sudo sed -i \
    "s/HOME_NET:.*/HOME_NET: \"$nueva_home\"/" \
    "$SURICATA_CONF"


    ok "HOME_NET actualizado."


    pause
}

informacion_sistema() {

    clear
    logo
    title

    subtitle "Información del sistema"


    echo "Sistema:"
    uname -s


    echo ""

    echo "Kernel:"
    uname -r


    echo ""

    echo "CPU:"
